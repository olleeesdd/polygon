// Структура для представления вершины
struct Vertex {
    double x, y; // Координаты вершины
    std::vector<std::pair<Vertex*, double>> connections; // Соседи и веса
};

// Граф для работы с вершинами
struct Network {
    std::unordered_map<std::string, Vertex*> vertices; // Карта всех вершин

    // Создание уникального ключа для координат
    std::string create_key(double x, double y) {
        return std::to_string(x) + "_" + std::to_string(y);
    }

    // Добавление вершины
    void add_vertex(double x, double y) {
        std::string key = create_key(x, y);
        if (vertices.find(key) == vertices.end()) {
            vertices[key] = new Vertex{ x, y };
        }
    }

    // Создание ребра между двумя вершинами
    void add_connection(double x1, double y1, double x2, double y2, double weight) {
        add_vertex(x1, y1);
        add_vertex(x2, y2);
        Vertex* v1 = vertices[create_key(x1, y1)];
        Vertex* v2 = vertices[create_key(x2, y2)];
        v1->connections.emplace_back(v2, weight);
    }

    // Поиск ближайшей вершины к заданным координатам
    Vertex* find_nearest_vertex(double x, double y) {
        Vertex* closest = nullptr;
        double min_dist = std::numeric_limits<double>::max();

        for (const auto& pair : vertices) {
            Vertex* v = pair.second;
            double distance = std::sqrt(std::pow(v->x - x, 2) + std::pow(v->y - y, 2));
            if (distance < min_dist) {
                closest = v;
                min_dist = distance;
            }
        }
        return closest;
    }
};

// Подсчет длины пути
double calculate_path_length(const std::vector<Vertex*>& path) {
    double total_length = 0.0;
    for (size_t i = 1; i < path.size(); ++i) {
        double dx = path[i]->x - path[i - 1]->x;
        double dy = path[i]->y - path[i - 1]->y;
        total_length += std::sqrt(dx * dx + dy * dy);
    }
    return total_length;
}

// BFS алгоритм
std::vector<Vertex*> breadth_first_search(Network& network, Vertex* start, Vertex* goal) {
    if (!start || !goal) return {};

    std::queue<std::vector<Vertex*>> paths;
    std::unordered_set<Vertex*> visited;
    paths.push({ start });

    while (!paths.empty()) {
        auto current_path = paths.front();
        paths.pop();

        Vertex* current = current_path.back();
        if (current == goal) return current_path;

        if (visited.count(current)) continue;
        visited.insert(current);

        for (const auto& neighbor : current->connections) {
            auto new_path = current_path;
            new_path.push_back(neighbor.first);
            paths.push(new_path);
        }
    }
    return {};
}

// DFS алгоритм
std::vector<Vertex*> depth_first_search(Network& network, Vertex* start, Vertex* goal) {
    if (!start || !goal) return {};

    std::unordered_set<Vertex*> visited;
    std::stack<std::pair<Vertex*, std::vector<Vertex*>>> stack;
    stack.push({ start, { start } });

    while (!stack.empty()) {
        auto current = stack.top();
        stack.pop();
        Vertex* current_vertex = current.first;
        std::vector<Vertex*> path = current.second;

        if (current_vertex == goal) return path;
        if (visited.count(current_vertex)) continue;

        visited.insert(current_vertex);

        for (const auto& neighbor : current_vertex->connections) {
            auto new_path = path;
            new_path.push_back(neighbor.first);
            stack.push({ neighbor.first, new_path });
        }
    }
    return {};
}

// Алгоритм Дейкстры
std::vector<Vertex*> dijkstra(Network& network, Vertex* start, Vertex* goal) {
    if (!start || !goal) return {};

    std::unordered_map<Vertex*, double> distance;
    std::unordered_map<Vertex*, Vertex*> previous;
    auto compare = [](const std::pair<Vertex*, double>& a, const std::pair<Vertex*, double>& b) {
        return a.second > b.second;
    };
    std::priority_queue<std::pair<Vertex*, double>, std::vector<std::pair<Vertex*, double>>, decltype(compare)> pq(compare);

    for (const auto& pair : network.vertices) {
        distance[pair.second] = std::numeric_limits<double>::infinity();
    }

    distance[start] = 0;
    pq.push({ start, 0 });

    while (!pq.empty()) {
        Vertex* current = pq.top().first;
        pq.pop();

        if (current == goal) break;

        for (const auto& neighbor : current->connections) {
            double new_dist = distance[current] + neighbor.second;
            if (new_dist < distance[neighbor.first]) {
                distance[neighbor.first] = new_dist;
                previous[neighbor.first] = current;
                pq.push({ neighbor.first, new_dist });
            }
        }
    }

    std::vector<Vertex*> path;
    for (Vertex* v = goal; v != nullptr; v = previous[v]) {
        path.push_back(v);
    }
    std::reverse(path.begin(), path.end());
    return path;
}

// Эвристика для A*
double heuristic(Vertex* a, Vertex* b) {
    return std::sqrt(std::pow(a->x - b->x, 2) + std::pow(a->y - b->y, 2));
}

// Алгоритм A*
std::vector<Vertex*> a_star(Network& network, Vertex* start, Vertex* goal) {
    if (!start || !goal) return {};

    std::unordered_map<Vertex*, double> g_score, f_score;
    std::unordered_map<Vertex*, Vertex*> came_from;
    auto compare = [](const std::pair<Vertex*, double>& a, const std::pair<Vertex*, double>& b) {
        return a.second > b.second;
    };
    std::priority_queue<std::pair<Vertex*, double>, std::vector<std::pair<Vertex*, double>>, decltype(compare)> pq(compare);

    g_score[start] = 0;
    f_score[start] = heuristic(start, goal);
    pq.push({ start, f_score[start] });

    while (!pq.empty()) {
        Vertex* current = pq.top().first;
        pq.pop();

        if (current == goal) break;

        for (const auto& neighbor : current->connections) {
            double tentative_g_score = g_score[current] + neighbor.second;

            if (g_score.find(neighbor.first) == g_score.end() || tentative_g_score < g_score[neighbor.first]) {
                came_from[neighbor.first] = current;
                g_score[neighbor.first] = tentative_g_score;
                f_score[neighbor.first] = g_score[neighbor.first] + heuristic(neighbor.first, goal);
                pq.push({ neighbor.first, f_score[neighbor.first] });
            }
        }
    }

    std::vector<Vertex*> path;
    for (Vertex* v = goal; v != nullptr; v = came_from[v]) {
        path.push_back(v);
    }
    std::reverse(path.begin(), path.end());
    return path;
}

// Функция для вывода пути
void display_path(const std::vector<Vertex*>& path) {
    for (const auto& v : path) {
        std::cout << "(" << v->x << ", " << v->y << ") -> ";
    }
    std::cout << "END\n";
}

int main() {
    Network network;

    // Создание тестового графа
    network.add_connection(0, 0, 1, 0, 1.0);
    network.add_connection(1, 0, 1, 1, 1.0);
    network.add_connection(1, 1, 0, 1, 1.0);
    network.add_connection(0, 1, 0, 0, 1.0);
    network.add_connection(0, 0, 1, 1, 1.5);

    double start_x = 0, start_y = 0;
    double goal_x = 1, goal_y = 1;

    Vertex* start = network.find_nearest_vertex(start_x, start_y);
    Vertex* goal = network.find_nearest_vertex(goal_x, goal_y);

    std::cout << "Сравнение алгоритмов поиска пути:\n";

    auto start_time = std::chrono::high_resolution_clock::now();
    auto bfs_path = breadth_first_search(network, start, goal);
    auto end_time = std::chrono::high_resolution_clock::now();
    std::cout << "BFS Path: ";
    display_path(bfs_path);
    std::cout << "Length: " << calculate_path_length(bfs_path) << "\n";
    std::cout << "Time: " << std::chrono::duration<double>(end_time - start_time).count() << " seconds.\n";

    start_time = std::chrono::high_resolution_clock::now();
    auto dfs_path = depth_first_search(network, start, goal);
    end_time = std::chrono::high_resolution_clock::now();
    std::cout << "DFS Path: ";
    display_path(dfs_path);
    std::cout << "Length: " << calculate_path_length(dfs_path) << "\n";
    std::cout << "Time: " << std::chrono::duration<double>(end_time - start_time).count() << " seconds.\n";

    start_time = std::chrono::high_resolution_clock::now();
    auto dijkstra_path = dijkstra(network, start, goal);
    end_time = std::chrono::high_resolution_clock::now();
    std::cout << "Dijkstra Path: ";
    display_path(dijkstra_path);
    std::cout << "Length: " << calculate_path_length(dijkstra_path) << "\n";
    std::cout << "Time: " << std::chrono::duration<double>(end_time - start_time).count() << " seconds.\n";

    start_time = std::chrono::high_resolution_clock::now();
    auto astar_path = a_star(network, start, goal);
    end_time = std::chrono::high_resolution_clock::now();
    std::cout << "A* Path: ";
    display_path(astar_path);
    std::cout << "Length: " << calculate_path_length(astar_path) << "\n";
    std::cout << "Time: " << std::chrono::duration<double>(end_time - start_time).count() << " seconds.\n";

    return 0;
}

